[Unit]
Description=kaeru-mcp — cognitive memory MCP server (HTTP daemon)
Documentation=https://github.com/LamantinAI/kaeru
After=default.target

[Service]
Type=simple
ExecStart={{ kaeru_mcp_bin }}
Restart=always
RestartSec=2
# Конфиг локальной аутентификации. Файла может не быть — свежая установка
# работает без auth; если файл создан (`kaeru-mcp auth`), он подхватится.
Environment="KAERU_MCP_WEB_CONFIG_FILE=%h/.config/kaeru/web.toml"
# Визуализатор показывает vault владельца: остальные инициативы локальны.
Environment=KAERU_MCP_VIZ_INITIATIVES=*
Environment=KAERU_MCP_VIZ_INCLUDE_LOCAL=1
# Хранилище по умолчанию — $XDG_DATA_HOME/kaeru (~/.local/share/kaeru).
# Порт и адрес можно поменять здесь: KAERU_MCP_LISTEN_ADDRESS=127.0.0.1,
# KAERU_MCP_LISTEN_PORT=9876, KAERU_MCP_MOUNT_PATH=/mcp.

[Install]
WantedBy=default.target
