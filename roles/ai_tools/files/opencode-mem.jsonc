{
  // Модель эмбеддингов: многоязычная, 1024 измерения, CLS-пулинг (плагин
  // определяет его по модели сам), квантование q8 — около 560 МБ на диске
  // вместо fp32. Дефолт плагина Xenova/nomic-embed-text-v1 обучен на
  // английском и на русских запросах даёт почти нулевой recall.
  "embeddingModel": "Xenova/bge-m3",
  "embeddingDtype": "q8",

  // Порог сравнивается не с косинусом, а со смешанной оценкой
  // 0.5*cos + 0.3*tags + 0.2*keyword (dist/services/turso/vector-search.js).
  // У записи без тегов потолок ~0.7, реальные значения релевантных пар
  // 0.28–0.47, поэтому дефолтный 0.6 не пропускает ничего.
  "similarityThreshold": 0.25
}
