# {{ nora_caddy_config }}
# Файл управляется Ansible (роль nora) — ручные правки будут перезаписаны.
# Caddy терминирует TLS сертом из mkcert и ведёт HTTPS на NORA (HTTP :4000).
# NORA TLS не терминирует сам — это делаем здесь.
# Локальные сервисы отдаются по HTTP (:80): http:// в адресе отключает
# автоматический HTTPS, иначе Caddy полез бы за сертом (ACME/внутренний CA).

{{ nora_hostname }}:443 {
    tls {{ nora_tls_cert }} {{ nora_tls_key }}

    reverse_proxy 127.0.0.1:{{ nora_port }} {
        header_up Host {host}
        header_up X-Real-IP {remote}
    }
}
{% for site in local_http_sites %}
http://{{ site.host }} {
{% if site.loopback_guard | default(false) %}
    # Приложение пускает только запросы на loopback-имя и с loopback-Origin
    # (защита от DNS rebinding и CSRF), поэтому Caddy подменяет Host на адрес
    # upstream, а Origin — только у страниц, открытых с этого же имени. Запрос
    # с чужого сайта уходит со своим Origin и получает от приложения 403, как
    # и при прямом обращении к loopback-порту.
    @same_origin header Origin http://{{ site.host }}
    handle @same_origin {
        reverse_proxy {{ site.upstream }} {
            header_up Host {{ site.upstream }}
            header_up Origin http://{{ site.upstream }}
        }
    }
    handle {
        reverse_proxy {{ site.upstream }} {
            header_up Host {{ site.upstream }}
        }
    }
{% else %}
    reverse_proxy {{ site.upstream }}
{% endif %}
}
{% endfor %}
